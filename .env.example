# Compose reads this file. Keep the default demo mode for an offline first run.
OPSPILOT_MODE=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
# Optional application access token. Required before exposing the service to other users.
OPSPILOT_API_TOKEN=
OPSPILOT_MAX_CONCURRENT=2
